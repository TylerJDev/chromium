interface mixin InvokeElement {
  [CEReactions,Reflect=invoketarget] attribute Element? invokeTargetElement;
  [CEReactions,Reflect,ReflectEmpty="auto",ReflectMissing="auto"] attribute DOMString invokeAction;
};
